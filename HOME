<!DOCTYPE html>
<html lang="sv">
<head>
  <meta charset="UTF-8">
  <title>Bildväxlare</title>
  <style>
    body {
      display: flex;
      justify-content: center;
      align-items: center;
      height: 100vh;
      margin: 0;
      background: #f0f0f0;
    }

    img {
      max-width: 80%;
      max-height: 80%;
      cursor: pointer;
      border-radius: 10px;
      box-shadow: 0 4px 15px rgba(0,0,0,0.2);
    }
  </style>
</head>
<body>

<img id="bild" src="bild1.jpg" alt="bild">

<script>
  const bilder = [
    "bild1.jpg",
    "bild2.jpg",
    "bild3.jpg",
    "bild4.jpg"
  ];

  let index = 0;
  const imgElement = document.getElementById("bild");

  imgElement.addEventListener("click", function () {
    index = (index + 1) % bilder.length;
    imgElement.src = bilder[index];
  });
</script>

</body>
</html>
